{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent47.local/rules/schema.json",
  "title": "agent47 rules schema",
  "type": "object",
  "required": ["metadata", "rules"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "last_updated", "owner", "review_cadence", "schema"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "last_updated": { "type": "string", "format": "date" },
        "owner": { "type": "string", "minLength": 1 },
        "review_cadence": { "enum": ["monthly", "quarterly", "annual"] },
        "schema": { "type": "string" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "topic", "severity", "applies_to", "rule"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stack prefixes (BE/FE/MO/SH/GO) take no slug; X requires a slug; SEC-* uses the language token directly.",
          "pattern": "^((BE|FE|MO|GO|CLI|SCR|INF|DT|PL|MR|SHC|SHT)|X-[a-z][a-z0-9-]*|SEC-(global|py|js-ts|java-kotlin|csharp|swift|go|shell))-[0-9]{3}$"
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
        },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["all", "backend", "frontend", "mobile", "shell", "scripts", "cli", "desktop", "infra", "monorepo", "plugin"] },
          "uniqueItems": true
        },
        "applies_when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "items": { "type": "string" } }
          }
        },
        "rule": { "type": "string", "minLength": 10 },
        "rationale": { "type": "string" },
        "how_to_apply": { "type": "string" },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "do": { "type": "string" },
            "dont": { "type": "string" }
          }
        },
        "refs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "superseded_by": {
          "type": ["string", "null"],
          "description": "Must match the same pattern as `id`.",
          "pattern": "^((BE|FE|MO|GO|CLI|SCR|INF|DT|PL|MR|SHC|SHT)|X-[a-z][a-z0-9-]*|SEC-(global|py|js-ts|java-kotlin|csharp|swift|go|shell))-[0-9]{3}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "severity": { "enum": ["critical", "high"] } } },
          "then": { "required": ["rationale"] }
        }
      ]
    }
  }
}
